+// Desk's one Vue: other bundles import "vue" from these objects (esbuild/frappe-vue.js).
+// A prebuilt element that keeps vue external reads frappe.Vue (Vite: `globals: { vue: "frappe.Vue" }`).
+import * as Vue from "vue";
+import * as reactivity from "@vue/reactivity";
+import * as shared from "@vue/shared";
+
+if (window.frappe?.Vue) {
+	console.warn("vue.bundle.js ran twice: keeping the frappe.Vue that loaded first");
+} else {
+	window.frappe ||= {};
+	frappe.Vue = Vue;
+	frappe.vue_modules = { vue: Vue, "@vue/reactivity": reactivity, "@vue/shared": shared };
+}
