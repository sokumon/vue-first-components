index 0000000..50f8786
--- /dev/null
+++ b/src/components/shared/slotOutlet.ts
@@ -0,0 +1,39 @@
+import { Comment, Fragment, isVNode } from 'vue'
+import type { FunctionalComponent, VNode, VNodeArrayChildren } from 'vue'
+
+// Same test as Vue's `ensureValidVNode`: a slot that renders only comments
+// (e.g. a `v-if` that is false) counts as empty, so the fallback shows.
+function hasContent(nodes: VNodeArrayChildren): boolean {
+  return nodes.some((child) => {
+    if (!isVNode(child)) return child != null && child !== false && child !== true
+    if (child.type === Comment) return false
+    if (child.type === Fragment && !hasContent(child.children as VNodeArrayChildren)) return false
+    return true
+  })
+}
+
+/**
+ * Renders a consumer slot from a component's own template WITHOUT a `<slot>`
+ * outlet. A `<slot>` inside another component's slot content makes the
+ * compiler mark that content FORWARDED, which turns into DYNAMIC_SLOTS (and a
+ * forced child re-render on every parent render) whenever this component's
+ * own slots are not compiler-stable — i.e. for every render-function or
+ * slot-less consumer. Reading `render` through `useReactiveSlots()` keeps the
+ * outlet subscribed to slot changes instead.
+ */
+export const SlotOutlet: FunctionalComponent<{
+  render?: ((props: any) => VNode[]) | undefined
+  slotProps?: object
+}> = (props, { slots }) => {
+  const out = props.render ? props.render(props.slotProps ?? {}) : undefined
+  const nodes = out == null ? [] : Array.isArray(out) ? out : [out]
+  if (hasContent(nodes)) {
+    // A lone element is returned bare, not in a Fragment, so attributes a
+    // parent merges in (e.g. reka's `as-child` click / aria on #trigger) fall
+    // through onto it exactly as they did onto the `<slot>` outlet's child.
+    const real = nodes.filter((n) => !(isVNode(n) && n.type === Comment))
+    return real.length === 1 ? real[0] : nodes
+  }
+  return slots.default ? slots.default() : null
+}
+SlotOutlet.props = ['render', 'slotProps']
