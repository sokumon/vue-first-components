 "src/components/Combobox/ComboboxResults.vue": {
  "abs": "/home/claude/vue-first-components/frappe-ui/src/components/Combobox/ComboboxResults.vue",
  "template": "\n  <ComboboxViewport class=\"flex max-h-60 flex-col overflow-auto p-1\">\n    <div\n      v-if=\"loading\"\n      data-slot=\"loading\"\n      class=\"flex items-center gap-2 px-2 py-1.5 text-base text-ink-gray-5\"\n    >\n      <Spinner class=\"size-4\" />\n      <span>Loading...</span>\n    </div>\n\n    <template v-else>\n      <div\n        v-if=\"showEmpty\"\n        data-slot=\"empty\"\n        class=\"px-2 py-1.5 text-base text-ink-gray-5\"\n      >\n        <component\n          :is=\"ItemSlotRender\"\n          v-if=\"slotFns.empty\"\n          :render=\"slotFns.empty\"\n          :slot-props=\"{ query }\"\n        />\n        <template v-else>{{ emptyText }}</template>\n      </div>\n\n      <template v-else>\n        <template\n          v-for=\"(group, groupIndex) in groups\"\n          :key=\"getGroupKey(group, groupIndex)\"\n        >\n          <ComboboxGroup data-slot=\"group\" class=\"flex flex-col\">\n            <ComboboxLabel\n              v-if=\"group.group && !group.hideLabel\"\n              data-slot=\"group-label\"\n              class=\"flex h-7 items-center px-2 text-sm-medium leading-tighter text-ink-gray-4\"\n            >\n              <component\n                :is=\"ItemSlotRender\"\n                v-if=\"slotFns['group-label']\"\n                :render=\"slotFns['group-label']\"\n                :slot-props=\"{ group }\"\n              />\n              <template v-else>{{ group.group }}</template>\n            </ComboboxLabel>\n\n            <ComboboxItem\n              v-for=\"item in group.options\"\n              :key=\"getItemKey(item)\"\n              :value=\"getComboboxItemValue(item)\"\n              :disabled=\"item.disabled\"\n              :text-value=\"getItemTextValue(item)\"\n              data-slot=\"item\"\n              :data-size=\"size\"\n              :data-state=\"\n                isSelectableOption(item)\n                  ? isItemSelected(item)\n                    ? 'checked'\n                    : 'unchecked'\n                  : undefined\n              \"\n              :class=\"[\n                itemClasses,\n                checkedItemClasses,\n                itemRootSizeClasses(size),\n              ]\"\n              @select=\"handleSelect(item, $event)\"\n            >\n              <!--\n                Full-row takeover precedence:\n                  1. item.slot matches a `#item-<slot>` template slot →\n                     default row shell with the named slot filling the\n                     label region (handled below). Per-item slot dispatch\n                     is intentionally more specific than the generic\n                     `#item` fallback.\n                  2. global `#item` template slot\n                  3. item.slots.item\n                  4. default row shell\n              -->\n              <component\n                :is=\"ItemSlotRender\"\n                v-if=\"slotFns.item && !shouldUseDynamicItemSlot(item)\"\n                :render=\"slotFns.item\"\n                :slot-props=\"getItemSlotProps(item)\"\n              />\n\n              <component\n                :is=\"ItemSlotRender\"\n                v-else-if=\"item.resolvedSlots.item\"\n                :render=\"item.resolvedSlots.item\"\n                :slot-props=\"getItemSlotProps(item)\"\n              />\n\n              <ItemListRow\n                v-else\n                :size=\"toItemListSize(size)\"\n                :selected=\"isItemSelected(item)\"\n                :disabled=\"item.disabled\"\n              >\n                <template #prefix>\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-if=\"slotFns['item-prefix']\"\n                    :render=\"slotFns['item-prefix']\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-else-if=\"item.resolvedSlots.prefix\"\n                    :render=\"item.resolvedSlots.prefix\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n                  <!--\n                    Auto-render `item.icon`: `lucide-*` strings go through\n                    the Tailwind plugin; emoji/symbol strings render as\n                    text; component values render directly. Consumer slots\n                    above still win.\n                  -->\n                  <OptionIcon v-else-if=\"item.icon\" :icon=\"item.icon\" />\n                </template>\n\n                <template #label>\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-if=\"shouldUseDynamicItemSlot(item)\"\n                    :render=\"slotFns[getDynamicItemSlotName(item)!]!\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-else-if=\"slotFns['item-label']\"\n                    :render=\"slotFns['item-label']\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-else-if=\"item.resolvedSlots.label\"\n                    :render=\"item.resolvedSlots.label\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n\n                  <div v-else class=\"min-w-0\">\n                    <div class=\"truncate leading-tighter\">{{ item.label }}</div>\n                    <div\n                      v-if=\"item.description\"\n                      class=\"truncate text-p-sm text-ink-gray-5\"\n                    >\n                      {{ item.description }}\n                    </div>\n                  </div>\n                </template>\n\n                <template #suffix>\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-if=\"slotFns['item-suffix']\"\n                    :render=\"slotFns['item-suffix']\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n                  <component\n                    :is=\"ItemSlotRender\"\n                    v-else-if=\"item.resolvedSlots.suffix\"\n                    :render=\"item.resolvedSlots.suffix\"\n                    :slot-props=\"getItemSlotProps(item)\"\n                  />\n\n                  <ComboboxItemIndicator\n                    v-if=\"isSelectableOption(item)\"\n                    class=\"ms-1 inline-flex items-center justify-center\"\n                  >\n                    <span class=\"lucide-check size-4 text-ink-gray-6\" />\n                  </ComboboxItemIndicator>\n                </template>\n              </ItemListRow>\n            </ComboboxItem>\n          </ComboboxGroup>\n        </template>\n      </template>\n    </template>\n  </ComboboxViewport>\n",
  "lang": "html",
  "sha": "633ef8443efbbbdfd9fcdf4e27d6c31730bd41efb8fe3d666077595cb5f10fa6"
 },
 "src/components/DesktopShell/DesktopShell.vue": {
  "abs": "/home/claude/vue-first-components/frappe-ui/src/components/DesktopShell/DesktopShell.vue",
  "template": "\n  <div\n    data-slot=\"desktop-shell\"\n    :class=\"['flex h-full', navSide === 'right' && 'flex-row-reverse']\"\n  >\n    <slot name=\"rail\" />\n    <slot name=\"sidebar\" />\n\n    <div\n      data-slot=\"desktop-shell-content\"\n      class=\"flex min-w-0 flex-1 flex-col overflow-hidden\"\n    >\n      <!-- Pages teleport their headers here; it stays pinned above the scroll. -->\n      <PageHeaderTarget ref=\"headerTarget\" />\n\n      <!--\n        The scroll region. Registered into the shared scroll-container registry\n        (via ScrollArea's exposed viewport element) so `shellScrollContainer`\n        and `useShellScrolled()` resolve it with zero app wiring.\n      -->\n      <ScrollArea v-if=\"scroll\" ref=\"scrollArea\" class=\"min-h-0 flex-1\">\n        <slot />\n      </ScrollArea>\n\n      <!--\n        scroll=false: the content area fills the remaining height and never\n        page-scrolls, so inner panes own their own overflow — a list + detail\n        split, or a horizontally-scrolling board whose columns scroll on their\n        own. Without this apps fake it with `absolute inset-0` / hardcoded\n        `h-[calc(100vh-3rem)]` / `[&>div]:h-full`.\n      -->\n      <div v-else class=\"flex min-h-0 flex-1 flex-col overflow-hidden\">\n        <slot />\n      </div>\n    </div>\n  </div>\n",
  "lang": "html",
  "sha": "ef79903ec2e731b7ab16a71a60808ed39a94fd67b4841f9707efcaf52ef20ca0"
 },
