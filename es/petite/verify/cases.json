 "src/components/Icon/Icon.vue": {
  "abs": "/home/claude/vue-first-components/frappe-ui/src/components/Icon/Icon.vue",
  "template": "\n  <span\n    v-if=\"typeof resolvedIcon === 'string' && isLucideIconString(resolvedIcon)\"\n    :class=\"[resolvedIcon]\"\n    v-bind=\"$attrs\"\n    aria-hidden=\"true\"\n  />\n  <span\n    v-else-if=\"\n      typeof resolvedIcon === 'string' && isEmojiIconString(resolvedIcon)\n    \"\n    class=\"inline-flex items-center justify-center leading-none\"\n    v-bind=\"$attrs\"\n    aria-hidden=\"true\"\n    >{{ resolvedIcon }}</span\n  >\n  <component\n    v-else-if=\"resolvedIcon && typeof resolvedIcon !== 'string'\"\n    :is=\"resolvedIcon\"\n    v-bind=\"$attrs\"\n    aria-hidden=\"true\"\n  />\n",
  "lang": "html",
  "sha": "e162601d46eadd737acfbc30dea9b7830b164616b50ac9aa26608a91b3818722"
 },
